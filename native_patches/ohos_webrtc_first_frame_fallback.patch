+
+void CameraCapturer::ArmFirstFrameWatchdog()
+{
+    CancelFirstFrameWatchdog();
+
+    rtc::Thread* captureThread = rtc::Thread::Current();
+    if (captureThread == nullptr) {
+        RTC_LOG(LS_ERROR) << "[OhosCapture][FirstFrame] cannot arm watchdog: no current capturer thread";
+        return;
+    }
+
+    auto state = std::make_shared<FirstFrameWatchdogState>();
+    state->owner = this;
+    firstFrameWatchdog_ = state;
+    RTC_LOG(LS_INFO) << "[OhosCapture][FirstFrame] watchdog armed route=video timeoutMs="
+                     << kFirstFrameTimeoutMs;
+    captureThread->PostDelayedTask(
+        [state] {
+            if (state->owner != nullptr) {
+                state->owner->HandleFirstFrameTimeout();
+            }
+        },
+        TimeDelta::Millis(kFirstFrameTimeoutMs));
+}
+
+void CameraCapturer::CancelFirstFrameWatchdog()
+{
+    if (firstFrameWatchdog_ != nullptr) {
+        firstFrameWatchdog_->owner = nullptr;
+        firstFrameWatchdog_.reset();
+    }
 }
 
+void CameraCapturer::HandleFirstFrameTimeout()
+{
+    CancelFirstFrameWatchdog();
+
+    if (!isInitialized_ || !isStarted_ || !usingVideoOutput_.load(std::memory_order_acquire)) {
+        return;
+    }
+    if (firstFrameReceived_.load(std::memory_order_acquire)) {
+        RTC_LOG(LS_INFO) << "[OhosCapture][FirstFrame] watchdog satisfied route=video";
+        return;
+    }
+
+    RTC_LOG(LS_WARNING) << "[OhosCapture][FirstFrame] timeout route=video timeoutMs="
+                        << kFirstFrameTimeoutMs
+                        << "; rebuilding CameraInput and switching to PreviewOutput";
+    isRuntimeFallback_.store(true, std::memory_order_release);
+    if (SwitchToPreviewOutputAfterFirstFrameTimeout()) {
+        RTC_LOG(LS_INFO) << "[OhosCapture][FirstFrame] fallback active route=preview-fallback";
+        return;
+    }
+
+    isRuntimeFallback_.store(false, std::memory_order_release);
+    RTC_LOG(LS_ERROR) << "[OhosCapture][FirstFrame] PreviewOutput fallback failed";
+    if (!captureSession_.IsEmpty()) {
+        // Preserve StopInternal's safety rule: if the camera service refused
+        // to stop the running session, do not release its input/output under it.
+        RTC_LOG(LS_ERROR) << "[OhosCapture][FirstFrame] keeping current session because stop did not complete";
+        return;
+    }
+    CleanupAfterFallbackFailure();
+}
+
+bool CameraCapturer::SwitchToPreviewOutputAfterFirstFrameTimeout()
+{
+    if (captureSession_.IsEmpty()) {
+        RTC_LOG(LS_ERROR) << "[OhosCapture][OutputRoute] runtime fallback failed stage=no_active_session";
+        return false;
+    }
+    if (!captureSession_.Stop()) {
+        RTC_LOG(LS_ERROR) << "[OhosCapture][OutputRoute] runtime fallback failed stage=stop_video_session";
+        return false;
+    }
+
+    captureSession_.Reset();
+    ResetCaptureOutputs();
+    usingVideoOutput_.store(false, std::memory_order_release);
+
+    if (!ReopenCameraInputForPreviewFallback()) {
+        RTC_LOG(LS_ERROR) << "[OhosCapture][OutputRoute] runtime fallback failed stage=reopen_input";
+        return false;
+    }
+
+    Camera_Device* device = nullptr;
+    for (std::size_t i = 0; i < cameraDevices_.Size(); ++i) {
+        if (cameraDevices_[i]->cameraId == deviceId_) {
+            device = cameraDevices_[i];
+            break;
+        }
+    }
+    if (device == nullptr) {
+        RTC_LOG(LS_ERROR) << "[OhosCapture][OutputRoute] runtime fallback failed stage=find_camera";
+        return false;
+    }
+
+    auto capability = CameraManager::GetInstance().GetSupportedCameraOutputCapability(device);
+    Camera_Profile* previewProfile = FindPreviewProfile(capability, device);
+    if (previewProfile == nullptr) {
+        RTC_LOG(LS_ERROR) << "[OhosCapture][OutputRoute] runtime fallback failed stage=find_preview_profile";
+        return false;
+    }
+
+    firstFrameReceived_.store(false, std::memory_order_release);
+    return StartCaptureSessionForOutput(previewProfile, nullptr);
+}
+
+void CameraCapturer::CleanupAfterFallbackFailure()
+{
+    captureSession_.Reset();
+    ResetCaptureOutputs();
+    usingVideoOutput_.store(false, std::memory_order_release);
+
+    if (!input_.IsEmpty()) {
+        input_.Close();
+        input_.Reset();
+    }
+    cameraDevices_.Reset();
+    ohos::DisplayManager::GetInstance().UnregisterChangeCallback(this);
+    isStarted_ = false;
+    NotifyCapturedStop();
+}
