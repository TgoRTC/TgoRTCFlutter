+Napi::Value NapiMediaStreamTrack::RestartCapture(const Napi::CallbackInfo& info)
+{
+    if (!track_ || !IsVideoTrack()) {
+        NAPI_THROW(Error::New(info.Env(), "restartCapture requires a video track"), info.Env().Undefined());
+    }
+
+    if (!track_->enabled() || track_->state() != MediaStreamTrackInterface::kLive) {
+        RTC_LOG(LS_INFO) << "[OhosCapture][ForegroundRecovery] skip disabled or ended track id="
+                         << track_->id();
+        return info.Env().Undefined();
+    }
+
+    auto source = factory_->GetVideoSource(track_);
+    if (!source) {
+        NAPI_THROW(Error::New(info.Env(), "video source not found"), info.Env().Undefined());
+    }
+
+    RTC_LOG(LS_INFO) << "[OhosCapture][ForegroundRecovery] restart requested trackId=" << track_->id();
+    source->RestartCapture();
+    return info.Env().Undefined();
+}
