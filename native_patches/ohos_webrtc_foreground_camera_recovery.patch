+void OhosVideoTrackSource::RestartCapture()
+{
+    if (is_destroying_.load(std::memory_order_acquire)) {
+        RTC_LOG(LS_WARNING) << "[OhosCapture][ForegroundRecovery] source destroying, skip";
+        return;
+    }
+
+    RTC_LOG(LS_INFO) << "[OhosCapture][ForegroundRecovery] queued on capture thread";
+    thread_->PostTask([capturer = capturer_] {
+        if (capturer) {
+            capturer->RestartCapture();
+        }
+    });
+}
