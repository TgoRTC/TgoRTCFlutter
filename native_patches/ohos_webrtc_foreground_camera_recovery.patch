+void CameraCapturer::RestartCapture()
+{
+    if (isRecovering_.exchange(true, std::memory_order_acq_rel)) {
+        RTC_LOG(LS_WARNING) << "[OhosCapture][ForegroundRecovery] recovery already in progress";
+        return;
+    }
+
+    RTC_LOG(LS_INFO) << "[OhosCapture][ForegroundRecovery] START this=" << this
+                     << " wasStarted=" << isStarted_;
+
+    CancelFirstFrameWatchdog();
+    isRuntimeFallback_.store(false, std::memory_order_release);
+    isSwitching_.store(false, std::memory_order_release);
+
+    // After the ability has returned to foreground, HarmonyOS can leave the
+    // wrapper in a nominally started state while the system CameraSession is
+    // already invalid. Stop is therefore best-effort: recovery must release
+    // every stale handle even when Stop() reports an error.
+    if (!captureSession_.IsEmpty() && !captureSession_.Stop()) {
+        RTC_LOG(LS_WARNING) << "[OhosCapture][ForegroundRecovery] stale session Stop failed; "
+                               "continuing forced teardown";
+    }
+    captureSession_.Reset();
+    ResetCaptureOutputs();
+
+    if (!input_.IsEmpty()) {
+        if (!input_.Close()) {
+            RTC_LOG(LS_WARNING) << "[OhosCapture][ForegroundRecovery] stale CameraInput Close failed; "
+                                   "continuing forced teardown";
+        }
+        input_.Reset();
+    }
+
+    cameraDevices_.Reset();
+    ohos::DisplayManager::GetInstance().UnregisterChangeCallback(this);
+    firstFrameReceived_.store(false, std::memory_order_release);
+    usingVideoOutput_.store(false, std::memory_order_release);
+    isStarted_ = false;
+
+    // Do not call NotifyCapturedStop(): the existing MediaStreamTrack and RTP
+    // sender must stay live while only the camera pipeline is rebuilt.
+    awaitingRecoveryFirstFrame_.store(true, std::memory_order_release);
+    StartInternal();
+    if (isStarted_) {
+        RTC_LOG(LS_INFO) << "[OhosCapture][ForegroundRecovery] SESSION_STARTED awaitingFirstFrame="
+                         << awaitingRecoveryFirstFrame_.load(std::memory_order_acquire)
+                         << " route="
+                         << (usingVideoOutput_.load(std::memory_order_acquire) ? "video" : "preview");
+    } else {
+        awaitingRecoveryFirstFrame_.store(false, std::memory_order_release);
+        RTC_LOG(LS_ERROR) << "[OhosCapture][ForegroundRecovery] FAILED stage=start_session";
+    }
+    isRecovering_.store(false, std::memory_order_release);
+}
