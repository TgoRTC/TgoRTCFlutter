+void VideoReceiveStream2::OnFrameBufferOverloaded(size_t buffered_frames) {
+  RTC_DCHECK_RUN_ON(&packet_sequence_checker_);
+  const Timestamp now = clock_->CurrentTime();
+  RTC_LOG(LS_WARNING)
+      << "[OhosReceive][Backpressure] requesting recovery keyframe"
+      << " buffered_frames=" << buffered_frames
+      << " ssrc=" << remote_ssrc();
+  keyframe_required_ = true;
+  RequestKeyFrame(now);
+}
